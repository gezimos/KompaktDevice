From f9348d632f42615053435479601fa255c0ffbbb6 Mon Sep 17 00:00:00 2001
From: gezimos <>
Date: Sat, 26 Sep 2026 15:59:17 +0200
Subject: [PATCH 4/5] Kompakt: recovery: adbd runs as shell, not root

Recovery no longer sets service.adb.root, so adbd drops to shell. Root
adbd could not open /dev/usb-ffs/adb on the Kompakt.

Change-Id: If45c4f4f9b8b8d9f26d18a07ae7a38980d08588a
---
 recovery_main.cpp | 8 ++++++--
 1 file changed, 6 insertions(+), 2 deletions(-)

diff --git a/recovery_main.cpp b/recovery_main.cpp
index 88dc3a4e970ca051c531ae6a822ff0599340b802..3ee4803aa9e5bae140e23dfb6486a030b4d0c2e9 100644
--- a/recovery_main.cpp
+++ b/recovery_main.cpp
@@ -526,10 +526,10 @@ int main(int argc, char** argv) {
   std::thread listener_thread(ListenRecoverySocket, ui, std::ref(action));
   listener_thread.detach();
 
-  // Set up adb_keys and enable root before starting ADB.
+  // Set up adb_keys before starting ADB.
+  // Kompakt: no service.adb.root. Root adbd cannot open /dev/usb-ffs/adb here.
   if (get_build_type() != "user" && !fastboot) {
     copy_userdata_files();
-    android::base::SetProperty("service.adb.root", "1");
   }
 
   device->InitDevice();
