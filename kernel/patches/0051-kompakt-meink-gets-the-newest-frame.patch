From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jackson Goode <54308792+jacksongoode@users.noreply.github.com>
Date: Thu, 19 Nov 2026 10:51:37 -0800
Subject: [PATCH] kompakt: meink gets the newest frame, not one held through a refresh

meink converts each frame as mtkfb hands it over and its event thread
takes it at once, then waits out the refresh in progress, so the panel
shows a frame captured a whole pass earlier.

A gate in kompakt_update lets one frame through at a time. The einklatch
thread follows that frame's refresh on BUSY and reopens the gate when only
meink's measured time with a frame is left in the pass, repainting a held
frame, so meink takes the newest one. Pass and hand-over are measured, so
it follows the mode, steps and speed the Kompakt app sets.

Rebased onto 0050 (KompaktDevice PR #1): off while asleep (AOD and
power-down frames go straight to meink, BUSY waits give up at once), held
frames do not count as wake frames for 0046, and latch_pass_ms,
latch_hand_ms and latch_holds are readable module parameters.
latch=0 (meink_loader parameter) is stock.

Proton Mail scroll, build 463, same boot (frame age median, outdated):
  Fast 5 steps  196 -> 124 ms, 63% -> 0%   update cycle 136 ms both
  Fast 2 steps  125 -> 99 ms,  35% -> 0%   88 -> 90 ms
  Text          627 -> 199 ms, 68% -> 0%   576 -> 578 ms
---
--- a/drivers/misc/mudita/eink_loader/loader.c
+++ b/drivers/misc/mudita/eink_loader/loader.c
@@ -25,6 +25,9 @@
 #include <linux/reboot.h>
 #include <linux/crc32.h>
 #include <linux/workqueue.h>
+#include <linux/kthread.h>
+#include <linux/ktime.h>
+#include <linux/of_gpio.h>
 #include <asm/cacheflush.h>
 
 MODULE_DESCRIPTION("E-Ink driver loader");
@@ -2213,10 +2216,113 @@
     if (atomic_read(&kompakt_asleep) || now < 0 || !frames || now != kompakt_wake_refreshes)
         return;
     pr_err("kompakt-eink: wake drew nothing (%d frames, %ld refreshes)\n", frames, now);
+}
+
+/* Kompakt: one frame at a time to meink; einklatch reopens the gate from BUSY just before the pass ends. */
+static int latch = 1;
+module_param(latch, int, 0644);
+MODULE_PARM_DESC(latch, "hand meink the newest frame when the panel frees up");
+/* Last measured pass and meink's time with a frame; frames held at the gate. */
+static unsigned int latch_pass_ms, latch_hand_ms, latch_holds;
+module_param(latch_pass_ms, uint, 0444);
+module_param(latch_hand_ms, uint, 0444);
+module_param(latch_holds, uint, 0444);
+
+/* BUSY low under 10 ms is not a pass; 2 s is stuck. */
+#define LATCH_BLIP_MS  10
+#define LATCH_STUCK_MS 2000
+
+static int kompakt_busy_gpio = -1;
+static struct task_struct *latch_task;
+static DECLARE_WAIT_QUEUE_HEAD(latch_wq);
+static DEFINE_SPINLOCK(latch_lock);
+static bool latch_open = true, latch_held;
+
+/* Wait for BUSY to read ready (or busy) until the deadline; asleep gives up at once. */
+static bool kompakt_wait_panel(bool ready, ktime_t until)
+{
+    while ((gpio_get_value(kompakt_busy_gpio) != 0) != ready) {
+        if (ktime_after(ktime_get(), until) || kthread_should_stop() ||
+            atomic_read(&kompakt_asleep))
+            return false;
+        usleep_range(1000, 2000);
+    }
+    return true;
 }
 
+/* Whether this frame goes to meink now; a held one is repainted when the gate opens. */
+static bool kompakt_latch_pass(void)
+{
+    bool pass;
+
+    if (!READ_ONCE(latch) || !latch_task || atomic_read(&kompakt_asleep))
+        return true;
+    spin_lock(&latch_lock);
+    pass = latch_open;
+    latch_open = false;
+    latch_held = !pass;
+    spin_unlock(&latch_lock);
+    if (pass)
+        wake_up(&latch_wq);
+    else
+        latch_holds++;
+    return pass;
+}
+
+static void kompakt_latch_open(void)
+{
+    bool held;
+
+    spin_lock(&latch_lock);
+    latch_open = true;
+    held = latch_held;
+    latch_held = false;
+    spin_unlock(&latch_lock);
+    if (held)
+        kompakt_request_repaint();
+}
+
+/* When the refresh of the frame just passed started, or 0 if none did. */
+static ktime_t kompakt_latch_start(void)
+{
+    ktime_t until = ktime_add_ms(ktime_get(), latch_pass_ms ? 2 * latch_pass_ms : LATCH_STUCK_MS);
+    ktime_t start;
+
+    while (kompakt_wait_panel(false, until)) {
+        start = ktime_get();
+        if (!kompakt_wait_panel(true, ktime_add_ms(start, LATCH_BLIP_MS)))
+            return start;
+    }
+    return 0;
+}
+
+static int kompakt_latch_fn(void *unused)
+{
+    unsigned int lead;
+    ktime_t start;
+
+    while (!kthread_should_stop()) {
+        wait_event_interruptible(latch_wq, !READ_ONCE(latch_open) || kthread_should_stop());
+        start = kompakt_latch_start();
+        if (start) {
+            /* Open while meink, plus one poll, still has time for the newest frame... */
+            lead = latch_hand_ms + 2;
+            kompakt_wait_panel(true, ktime_add_ms(start, !latch_pass_ms ? LATCH_STUCK_MS :
+                                                  latch_pass_ms > lead ? latch_pass_ms - lead : 0));
+        }
+        kompakt_latch_open();
+        /* ...and time the whole pass for the next frame. */
+        if (start && kompakt_wait_panel(true, ktime_add_ms(start, LATCH_STUCK_MS)))
+            latch_pass_ms = ktime_ms_delta(ktime_get(), start);
+    }
+    return 0;
+}
+
 static int kompakt_update(void *ptr)
 {
+    ktime_t t;
+    int ret;
+
     if (atomic_read(&kompakt_powering_down) || atomic_read(&kompakt_final)) {
         /* Force the next capture to differ; under mtkfb's screen_buf_lock. */
         ((u8 *)ptr)[0] ^= 0x01;
@@ -2224,14 +2330,19 @@
                 atomic_inc_return(&kompakt_held));
         return 0;
     }
+    if (!kompakt_latch_pass())
+        return 0;
     atomic_inc(&kompakt_wake_frames);
+    t = ktime_get();
     if (READ_ONCE(kompakt_bayer_on)) {
         void *d = READ_ONCE(kompakt_dither) == 3 ? kompakt_hybrid(ptr) : kompakt_bayer(ptr);
 
         if (d)
-            return meink_update(d);
+            ptr = d;
     }
-    return meink_update(ptr);
+    ret = meink_update(ptr);
+    latch_hand_ms = ktime_ms_delta(ktime_get(), t);
+    return ret;
 }
 
 static bool kompakt_is_powerdown(unsigned long event, void *data)
@@ -2564,6 +2675,14 @@
     }
     meink_update_owner = mod;
     meink_update = (int (*)(void *))fn;
+    kompakt_busy_gpio = of_get_named_gpio(g_einkData.spi->dev.of_node, "eink,busy-gpio", 0);
+    if (gpio_is_valid(kompakt_busy_gpio)) {
+        latch_task = kthread_run(kompakt_latch_fn, NULL, "einklatch");
+        if (IS_ERR(latch_task))
+            latch_task = NULL;
+    }
+    pr_info("kompakt-eink: newest-frame latch %s (busy gpio %d)\n",
+            latch_task ? "running" : "off", kompakt_busy_gpio);
     fb_register_client(&kompakt_powerdown_begin_nb);
     fb_register_client(&kompakt_powerdown_end_nb);
     register_eink_refresh_func(kompakt_update);
@@ -2603,6 +2722,10 @@
         meink_aod = NULL;
     }
     register_eink_refresh_func(meink_update);
+    kompakt_drain_update();
+    if (latch_task)
+        kthread_stop(latch_task);
+    latch_task = NULL;
     fb_unregister_client(&kompakt_powerdown_end_nb);
     fb_unregister_client(&kompakt_powerdown_begin_nb);
     module_put(meink_update_owner);
