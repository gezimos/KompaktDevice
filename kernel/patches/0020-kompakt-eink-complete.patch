+/*
+ * Painting with the rail down: send PON and meink's last config word directly.
+ * Not through eink_write: an unpowered panel never raises BUSY.
+ */
+static void eink_repower(struct EinkHal *hw, struct spi_device *spi)
+{
+    unsigned char pon = CMD_PON;
+
+    spi_write(spi, &pon, 1);
+    msleep(90);
+    if (conf_len)
+        spi_write(spi, conf_cmd, conf_len);
