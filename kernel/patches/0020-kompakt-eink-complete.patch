+    /* Ratelimited: a read arrives a page at a time. */
+    if (!addr)
+        pr_err_ratelimited("kompakt-sleepimg: %s not found in %s\n",
+                           SLEEPIMG_SYMBOL, SLEEPIMG_MODULE);
+    return (u8 *)addr;
+}
