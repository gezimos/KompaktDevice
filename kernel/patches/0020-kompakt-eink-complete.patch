+            lut_crc[2], lut_len[2]);
+    avg = div64_s64(total, (s64)cnt);
+    return scnprintf(buf, n,
+        "last=%lld min=%lld avg=%lld max=%lld count=%lu mode=%02x "
+        "luts=%lu lutc=%08x/%u lutd=%08x/%u lutr=%08x/%u\n",
+        last, mn, avg, mx, cnt, mode,
