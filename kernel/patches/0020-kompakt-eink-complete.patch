+/* Copy into read-only module memory through a writable alias of its pages. */
+static int sleepimg_poke(u8 *dst, const u8 *src, size_t len)
+{
+    unsigned long base = (unsigned long)dst & PAGE_MASK;
+    size_t off = (unsigned long)dst - base;
+    unsigned int n = DIV_ROUND_UP(off + len, PAGE_SIZE);
+    struct page **pages;
+    unsigned int i;
+    u8 *alias;
+    int ret = 0;
+
+    pages = kmalloc_array(n, sizeof(*pages), GFP_KERNEL);
+    if (!pages)
+        return -ENOMEM;
+    for (i = 0; i < n; i++) {
+        pages[i] = vmalloc_to_page((void *)(base + i * PAGE_SIZE));
+        if (!pages[i]) {
+            ret = -EFAULT;
+            goto out;
+        }
+    }
+    alias = vmap(pages, n, VM_MAP, PAGE_KERNEL);
+    if (!alias) {
+        ret = -ENOMEM;
+        goto out;
+    }
+    /* Prove the alias shows the target before writing anything through it. */
+    if (memcmp(alias + off, dst, 64)) {
+        pr_err("kompakt-sleepimg: alias does not map the array\n");
+        ret = -EFAULT;
+    } else {
+        memcpy(alias + off, src, len);
+    }
+    vunmap(alias);
+out:
+    kfree(pages);
+    return ret;
+}
