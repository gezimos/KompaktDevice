+static int kompakt_powerdown_end(struct notifier_block *nb,
+                                 unsigned long event, void *data)
+{
+    if (kompakt_is_powerdown(event, data)) {
+        atomic_set(&kompakt_powering_down, 0);
+        pr_info("kompakt-sleepimg: power-down painted, %d frame(s) held off it\n",
+                atomic_read(&kompakt_held));
+    }
