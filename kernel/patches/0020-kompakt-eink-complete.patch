 #if defined(CONFIG_PANEL_EINK_TCON) || defined(CONFIG_PANEL_EINK_TCON_MODULE) || defined(CONFIG_EINK_MTKFB_SUPPORT)
 static int (*eink_update_func)(void *ptr) = NULL;
