+/* A meink symbol at least min_size long inside its core, or 0.
+ * Caller holds a reference.
+ */
+static unsigned long meink_symbol(struct module *mod, const char *name,
+                                  unsigned long min_size)
+{
+    struct mod_kallsyms *ks;
+    unsigned long addr = 0;
+    unsigned int i;
+
+    preempt_disable();
+    ks = rcu_dereference_sched(mod->kallsyms);
+    for (i = 0; i < ks->num_symtab; i++) {
+        const Elf_Sym *sym = &ks->symtab[i];
+
+        if (sym->st_size < min_size || strcmp(ks->strtab + sym->st_name, name))
+            continue;
+        if (within_module_core(sym->st_value, mod) &&
+            within_module_core(sym->st_value + min_size - 1, mod))
+            addr = sym->st_value;
+        break;
+    }
+    preempt_enable();
+    return addr;
+}
+
+/* meink, pinned until the caller's module_put, or NULL. */
+static struct module *meink_get(void)
+{
+    struct module *mod;
+
+    mutex_lock(&module_mutex);
+    mod = find_module(SLEEPIMG_MODULE);
+    if (mod && (mod->state != MODULE_STATE_LIVE || !try_module_get(mod)))
+        mod = NULL;
+    mutex_unlock(&module_mutex);
+    return mod;
+}
+
+/* The live array, with meink pinned until the caller's module_put. */
+static u8 *sleepimg_find(struct module **owner)
+{
+    struct module *mod;
+    unsigned long addr = 0;
+
+    *owner = NULL;
+    mod = meink_get();
+    if (mod) {
+        addr = meink_symbol(mod, SLEEPIMG_SYMBOL, SLEEPIMG_BYTES);
+        if (addr)
