+ * controller drops SPI writes that arrive during a waveform pass.
+ */
+static int eink_send_box(struct EinkHal *hw, struct spi_device *spi,
+                         const unsigned char *px, unsigned int rb,
+                         const struct eink_box *bx, unsigned char depth,
+                         unsigned char mode)
+{
+    unsigned int bw   = bx->c1 - bx->c0 + 1;
+    unsigned int rows = bx->y1 - bx->y0 + 1;
+    unsigned int ppb  = (depth == 0x00) ? 8 : 2;      /* pixels per byte */
+    unsigned int x0   = bx->c0 * ppb;                 /* -> top of the band */
+    unsigned int w    = bw * ppb;                     /* -> height of band */
+    unsigned char hdr[10];
+    unsigned char *out;
+    unsigned int i;
+    int rc;
+
+    hdr[0] = CMD_WINDOW;
+    eink_put_rect(hdr + 1, x0, bx->y0, w, rows);
+    eink_waitForReady(hw);
+    if (spi_write(spi, hdr, 9))
+        return -1;
+
+    out = kmalloc(bw * rows + 2, GFP_KERNEL);
+    if (out == NULL)
+        return -1;
+    out[0] = CMD_IMAGE;
+    out[1] = depth;
+    for (i = 0; i < rows; i++)
+        memcpy(out + 2 + i * bw, px + (bx->y0 + i) * rb + bx->c0, bw);
+    eink_waitForReady(hw);
+    rc = spi_write(spi, out, bw * rows + 2);
+    kfree(out);
+    if (rc)
+        return -1;
+
+    /* the refresh must carry the same rectangle */
+    hdr[0] = CMD_REFRESH;
+    hdr[1] = mode;
+    eink_put_rect(hdr + 2, x0, bx->y0, w, rows);
+    eink_waitForReady(hw);
+    return spi_write(spi, hdr, 10) ? -1 : 0;
+}
+
+/* Stage the bbox of changed bytes so the refresh after a full frame can skip
+ * the rest. Needs col_any from the diff.
+ */
+static void eink_semi_stage(unsigned int rb, unsigned char depth)
+{
+    unsigned int j, c0 = rb, c1 = 0;
+
+    semi_valid = 0;
+    if (!semi_partial)
+        return;
+
+    for (j = 0; j < rb; j++)
+        if (col_any[j]) {
+            if (j < c0)
+                c0 = j;
+            c1 = j;
+        }
+    if (c0 > c1)
+        return;
+
+    c0 = (c0 / XALIGN) * XALIGN;
+    c1 = ((c1 / XALIGN) + 1) * XALIGN - 1;
+    if (c1 >= rb)
+        c1 = rb - 1;
+    if (c0 + (rb - 1 - c1) < XALIGN)     /* too little excluded to bother */
+        return;
+
+    semi_c0 = c0;
+    semi_c1 = c1;
+    semi_rb = rb;
+    semi_depth = depth;
+    semi_valid = 1;
+}
+
+/* Refresh the staged band only; the full frame's pixels already went out. */
+static int eink_semi_refresh(struct EinkHal *hw, struct spi_device *spi,
+                             unsigned char mode)
+{
+    unsigned int ppb = (semi_depth == 0x00) ? 8 : 2;
+    unsigned int x0  = semi_c0 * ppb;
+    unsigned int w   = (semi_c1 - semi_c0 + 1) * ppb;
+    unsigned char hdr[10];
+
+    if (semi_window) {
+        hdr[0] = CMD_WINDOW;
+        eink_put_rect(hdr + 1, x0, 0, w, EINK_H);
+        eink_waitForReady(hw);
+        if (spi_write(spi, hdr, 9))
+            return -1;
+    }
+
+    hdr[0] = CMD_REFRESH;
+    hdr[1] = mode;
+    eink_put_rect(hdr + 2, x0, 0, w, EINK_H);
+    eink_waitForReady(hw);
+    if (spi_write(spi, hdr, 10) == 0)
+        return 0;
+
+    /* put the window back so the caller's own full refresh still works */
+    if (semi_window) {
+        hdr[0] = CMD_WINDOW;
+        eink_put_rect(hdr + 1, 0, 0, EINK_W, EINK_H);
+        eink_waitForReady(hw);
+        spi_write(spi, hdr, 9);
+    }
+    return -1;
+}
+
+/* Image command: diff and stage, but do not send. The waveform mode only
+ * arrives with the 0x12 that follows.
+ */
+static int eink_partial_image(struct EinkHal *hw, struct spi_device *spi,
+                              const unsigned char *buf, unsigned int size)
+{
+    const unsigned char depth = buf[1];
+    const unsigned int  rb    = eink_row_bytes(depth);
+    const unsigned char *px   = buf + 2;
+    const unsigned int  pxlen = size - 2;
+    unsigned int i, j, k, changed_cols = 0;
+    int run = -1;
+
+    pend_valid = 0;
+    swallow_refresh = 0;
+    semi_valid = 0;
+
+    if (!partial || rb == 0 || rb > sizeof(col_any) || pxlen != rb * EINK_H)
+        return 0;
+
+    if (last_frame == NULL || pend_frame == NULL || last_len != pxlen) {
+        kfree(last_frame);
+        kfree(pend_frame);
+        last_frame = kmalloc(pxlen, GFP_KERNEL);
+        pend_frame = kmalloc(pxlen, GFP_KERNEL);
+        if (last_frame == NULL || pend_frame == NULL) {
+            kfree(last_frame);
+            kfree(pend_frame);
+            last_frame = NULL;
+            pend_frame = NULL;
+            last_len = 0;
+            return 0;
+        }
+        memcpy(last_frame, px, pxlen);
+        last_len = pxlen;
+        eink_auto_keepalive();           /* depth change: auto just switched */
+        return 0;                        /* first frame goes out whole */
+    }
+
+    if (force_full) {                    /* new waveform: re-render in full */
+        force_full = 0;
+        partial_run = 0;
+        memcpy(last_frame, px, pxlen);
+        eink_auto_keepalive();           /* the LUT auto just uploaded */
+        return 0;
+    }
+
+    /* which byte offsets within a row changed, anywhere down the panel */
+    memset(col_any, 0, rb);
+    for (i = 0; i < EINK_H; i++) {
+        const unsigned char *a = last_frame + i * rb;
+        const unsigned char *b = px + i * rb;
+
+        for (j = 0; j < rb; j++)
+            if (a[j] != b[j])
+                col_any[j] = 1;
+    }
+    for (j = 0; j < rb; j++)
+        if (col_any[j]) changed_cols++;
+
+    eink_auto_note(changed_cols, rb);
+
+    if (changed_cols == 0) {
+        swallow_refresh = 1;             /* drop the refresh that follows too */
+        return 1;
+    }
+    if (partial_max_pct > 0 &&
+        changed_cols * 100 >= (unsigned int)partial_max_pct * rb) {
+        partial_run = 0;                 /* a scroll: everything moved */
+        eink_semi_stage(rb, depth);
+        memcpy(last_frame, px, pxlen);
+        return 0;
+    }
+    if (partial_full_every > 0 &&
+        ++partial_run >= (unsigned int)partial_full_every) {
+        partial_run = 0;
+        memcpy(last_frame, px, pxlen);
+        pr_info("einkpart: full refresh to clear residue\n");
+        return 0;
+    }
+
+    /* group changed offsets into bands, merging gaps shorter than COL_GAP */
+    nboxes = 0;
+    for (j = 0; j < rb; j++) {
+        if (col_any[j]) {
+            if (run < 0) {
+                if (nboxes == MAX_BOXES) { nboxes = 0; break; }
+                run = nboxes++;
+                boxes[run].c0 = j;
+            }
+            boxes[run].c1 = j;
+        } else if (run >= 0) {
+            for (k = 1; k <= COL_GAP && j + k < rb; k++)
+                if (col_any[j + k]) break;
+            if (k > COL_GAP)
+                run = -1;                /* gap wide enough to split here */
+        }
+    }
+    if (nboxes == 0) {                   /* too fragmented: one full update */
+        eink_semi_stage(rb, depth);
+        memcpy(last_frame, px, pxlen);
+        return 0;
+    }
+
+    /* round each band out on the byte axis, then merge any that now touch */
+    for (i = 0; i < nboxes; i++) {
+        boxes[i].c0 = (boxes[i].c0 / XALIGN) * XALIGN;
+        boxes[i].c1 = ((boxes[i].c1 / XALIGN) + 1) * XALIGN - 1;
+        if (boxes[i].c1 >= rb)
+            boxes[i].c1 = rb - 1;
+    }
+    for (i = 1; i < nboxes; ) {
+        if (boxes[i].c0 <= boxes[i - 1].c1 + 1) {
+            if (boxes[i].c1 > boxes[i - 1].c1)
+                boxes[i - 1].c1 = boxes[i].c1;
+            for (j = i; j + 1 < nboxes; j++)
+                boxes[j] = boxes[j + 1];
+            nboxes--;
+        } else {
+            i++;
+        }
+    }
+
+    /*
+     * Split each band into runs of changed rows, one rectangle per run, so a
+     * seekbar changing at both ends of a strip does not repaint all of it.
+     * Stays within MAX_BOXES; a band that would exceed it keeps one span.
+     */
+    {
+    unsigned int obn = 0;
+
+    for (i = 0; i < nboxes && obn < MAX_BOXES; i++) {
+        unsigned int c0 = boxes[i].c0, c1 = boxes[i].c1;
+        unsigned int lo = EINK_H, hi = 0;
+        unsigned int runs = 0;
+
+        memset(row_any, 0, EINK_H);
+        for (j = 0; j < EINK_H; j++) {
+            const unsigned char *a = last_frame + j * rb;
+            const unsigned char *b = px + j * rb;
+
+            for (k = c0; k <= c1; k++) {
+                if (a[k] != b[k]) {
+                    row_any[j] = 1;
+                    if (j < lo) lo = j;
+                    hi = j;
+                    break;
+                }
+            }
+        }
+        if (lo > hi) {                   /* cannot happen, but be safe */
+            obx[obn].c0 = c0;
+            obx[obn].c1 = c1;
+            obx[obn].y0 = 0;
+            obx[obn].y1 = EINK_H - 1;
+            obn++;
+            continue;
+        }
+
+        /* close gaps shorter than ROW_GAP, so a run is simply contiguous */
+        j = lo;
+        while (j <= hi) {
+            if (row_any[j]) { j++; continue; }
+            k = j;
+            while (k <= hi && !row_any[k]) k++;
+            if (k - j < ROW_GAP) {
+                for (; j < k; j++)
+                    row_any[j] = 1;
+            } else {
+                j = k;
+            }
+        }
+
+        for (j = lo; j <= hi; j++)
+            if (row_any[j] && (j == lo || !row_any[j - 1]))
+                runs++;
+
+        if (runs == 0 || obn + runs > MAX_BOXES) {
+            /* no budget to split it: one span, exactly as before */
+            obx[obn].c0 = c0;
+            obx[obn].c1 = c1;
+            obx[obn].y0 = (lo > ROW_SLACK) ? lo - ROW_SLACK : 0;
+            obx[obn].y1 = (hi + ROW_SLACK < EINK_H) ? hi + ROW_SLACK : EINK_H - 1;
+            obn++;
+            continue;
+        }
+
+        for (j = lo; j <= hi; j++) {
+            if (!row_any[j])
+                continue;
+            k = j;
+            while (k <= hi && row_any[k])
+                k++;
+            obx[obn].c0 = c0;
+            obx[obn].c1 = c1;
+            obx[obn].y0 = (j > ROW_SLACK) ? j - ROW_SLACK : 0;
+            obx[obn].y1 = (k - 1 + ROW_SLACK < EINK_H) ? k - 1 + ROW_SLACK
+                                                       : EINK_H - 1;
+            obn++;
+            j = k;
+        }
+    }
+
+    for (i = 0; i < obn; i++)
+        boxes[i] = obx[i];
+    nboxes = obn;
+    }
+
+    memcpy(pend_frame, px, pxlen);
+    pend_rb = rb;
+    pend_depth = depth;
+    pend_valid = 1;
+    return 1;                            /* swallow: we send it at the 0x12 */
+}
+
+/*
+ * Refresh command: send the staged rectangles. last_frame advances only for
+ * rectangles that went out, so a failed one is retried on the next frame.
+ */
+static int eink_partial_refresh(struct EinkHal *hw, struct spi_device *spi,
+                                const unsigned char *buf)
+{
+    const unsigned char mode = buf[1];
+    unsigned int i, r, sent = 0;
+
+    if (swallow_refresh) {
+        swallow_refresh = 0;
+        return 1;
+    }
+    if (!pend_valid) {
+        if (semi_valid) {
+            semi_valid = 0;
+            if (eink_semi_refresh(hw, spi, mode) == 0) {
+                pr_info("einkpart: semi refresh mode=%02x bytes %u..%u of %u\n",
+                        mode, semi_c0, semi_c1, semi_rb);
+                return 1;
+            }
+            pr_warn("einkpart: semi refresh failed; full refresh follows\n");
+        }
+        return 0;
+    }
+    pend_valid = 0;
+
+    for (i = 0; i < nboxes; i++) {
+        unsigned int c0 = boxes[i].c0;
+        unsigned int bw = boxes[i].c1 - c0 + 1;
+
+        if (eink_send_box(hw, spi, pend_frame, pend_rb, &boxes[i],
+                          pend_depth, mode)) {
+            pr_warn("einkpart: rect %u of %u failed; left stale so the next "
+                    "frame retries it\n", i, nboxes);
+            break;
+        }
+        for (r = boxes[i].y0; r <= boxes[i].y1; r++)
+            memcpy(last_frame + r * pend_rb + c0,
+                   pend_frame + r * pend_rb + c0, bw);
+        sent += bw * (boxes[i].y1 - boxes[i].y0 + 1);
+    }
+
+    pr_info("einkpart: %u rect(s) mode=%02x, %u B instead of %u\n",
+            nboxes, mode, sent, pend_rb * EINK_H);
+    return 1;
+}
