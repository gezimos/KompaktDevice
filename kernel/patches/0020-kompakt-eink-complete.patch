+        }
+        err = sleepimg_orig ? sleepimg_poke(img, sleepimg_stage, SLEEPIMG_BYTES)
+                            : -ENOMEM;
+        module_put(owner);
+        if (err)
+            ret = err;
+        else
+            pr_info("kompakt-sleepimg: sleep screen replaced\n");
+    }
+    vfree(sleepimg_stage);
+    sleepimg_stage = NULL;
+    sleepimg_staged = 0;
+out:
+    mutex_unlock(&sleepimg_mutex);
+    return ret;
+}
+
+static ssize_t sleep_image_stock_read(struct file *filp, struct kobject *kobj,
