+    register_eink_refresh_func(meink_update);
+    fb_unregister_client(&kompakt_powerdown_end_nb);
+    fb_unregister_client(&kompakt_powerdown_begin_nb);
+    module_put(meink_update_owner);
+    meink_update = NULL;
+}
+
