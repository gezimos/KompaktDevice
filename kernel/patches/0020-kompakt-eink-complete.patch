+/* What meink was last told, not the display power mode: the DOZE enter
+ * path calls eink_aod_func(1) even when the display never reached DOZE.
+ */
+static bool kompakt_eink_in_aod;
+
+/* Frame-path tracing (trigger, capture, flush, eink_update_func), off by
+ * default. Set kompakt_frame_trace_on to arm it for 15 s after an AOD exit.
+ */
+static bool kompakt_frame_trace_on;
+static unsigned long kompakt_trace_until;
+
+static void kompakt_arm_frame_trace(void)
+{
+	if (kompakt_frame_trace_on)
+		kompakt_trace_until = jiffies + msecs_to_jiffies(15000);
+}
+
+static bool kompakt_frame_trace(void)
+{
+	return kompakt_trace_until && time_before(jiffies, kompakt_trace_until);
+}
 
