+    meink_update_owner = mod;
+    meink_update = (int (*)(void *))fn;
+    fb_register_client(&kompakt_powerdown_begin_nb);
+    fb_register_client(&kompakt_powerdown_end_nb);
+    register_eink_refresh_func(kompakt_update);
+    pr_info("kompakt-sleepimg: pump frames held across power-down (hook wrapped after EinkInit)\n");
+}
+
+static void kompakt_hold_exit(void)
+{
+    if (!meink_update)
