+    mod_delayed_work(system_wq, &auto_idle_work,
+                     msecs_to_jiffies(auto_idle_ms));
+
+    if (pct100 < (unsigned int)auto_busy_pct * rb) {
+        auto_busy_run = 0;               /* active, but not fast worthy */
+        return;
+    }
+
+    auto_busy_run++;
+    if (!auto_moving && auto_busy_frames > 0 &&
+        auto_busy_run >= (unsigned int)auto_busy_frames)
+        schedule_work(&auto_fast_work);
