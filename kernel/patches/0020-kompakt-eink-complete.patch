+static ssize_t sleep_image_read(struct file *filp, struct kobject *kobj,
+                                struct bin_attribute *attr, char *buf,
+                                loff_t off, size_t count)
+{
+    struct module *owner;
+    u8 *img;
+
+    if (off >= SLEEPIMG_BYTES)
+        return 0;
+    count = min_t(size_t, count, SLEEPIMG_BYTES - off);
+    img = sleepimg_find(&owner);
+    if (!img)
+        return -ENODEV;
+    memcpy(buf, img + off, count);
+    module_put(owner);
+    return count;
+}
+
+static ssize_t sleep_image_write(struct file *filp, struct kobject *kobj,
+                                 struct bin_attribute *attr, char *buf,
+                                 loff_t off, size_t count)
+{
+    struct module *owner;
+    ssize_t ret = count;
+    u8 *img;
+    int err;
+
+    if (off >= SLEEPIMG_BYTES || count > SLEEPIMG_BYTES - off)
+        return -EFBIG;
+
+    mutex_lock(&sleepimg_mutex);
+    /* Offset 0 starts a new picture; anything out of order is refused. */
+    if (off == 0)
+        sleepimg_staged = 0;
+    if (off != sleepimg_staged) {
+        ret = -EINVAL;
+        goto out;
+    }
+    if (!sleepimg_stage) {
+        sleepimg_stage = vmalloc(SLEEPIMG_BYTES);
+        if (!sleepimg_stage) {
+            ret = -ENOMEM;
+            goto out;
+        }
+    }
+    memcpy(sleepimg_stage + off, buf, count);
+    sleepimg_staged += count;
+    if (sleepimg_staged < SLEEPIMG_BYTES)
+        goto out;
+
+    img = sleepimg_find(&owner);
+    if (!img) {
+        ret = -ENODEV;
+    } else {
+        /* Nothing has written the array yet this boot, so it is Mudita's. */
+        if (!sleepimg_orig) {
+            sleepimg_orig = vmalloc(SLEEPIMG_BYTES);
+            if (sleepimg_orig)
