+/* Detect a screen-off de-ghost frame: full 4bpp, uniform white or black.
+ * The white frame decides whether the pair is skipped.
+ */
+static int eink_is_deghost(const unsigned char *b, unsigned int size)
+{
+    unsigned int i;
+    unsigned char fill;
+
+    if (deghost_every <= 1)
+        return 0;
+    if (size != 2 + EINK_W * EINK_H / 2 || b[1] != 0x03)
+        return 0;
+    fill = b[2];
+    if (fill != 0x00 && fill != 0xff)
+        return 0;
+    for (i = 3; i < size; i++)
+        if (b[i] != fill)
+            return 0;
+
+    if (fill == 0xff) {
+        deghost_run++;
+        deghost_skip = (deghost_run % (unsigned int)deghost_every) != 0;
+        if (deghost_skip)
+            pr_info("einkpart: de-ghost flash skipped (%u/%d)\n",
+                    deghost_run % (unsigned int)deghost_every, deghost_every);
+    }
+    return deghost_skip;
+}
