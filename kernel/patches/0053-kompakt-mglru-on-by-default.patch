From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jackson Goode <54308792+jacksongoode@users.noreply.github.com>
Date: Thu, 26 Nov 2026 10:42:01 -0800
Subject: [PATCH] kompakt: MGLRU on by default

CONFIG_LRU_GEN and CONFIG_LRU_GEN_ENABLED, as on the PVG100. To switch it
off at runtime, echo 0 > /sys/kernel/mm/lru_gen/enabled
---
 arch/arm64/configs/Kompakt_defconfig | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/arch/arm64/configs/Kompakt_defconfig b/arch/arm64/configs/Kompakt_defconfig
index 483a1b338..1ff55f2e0 100644
--- a/arch/arm64/configs/Kompakt_defconfig
+++ b/arch/arm64/configs/Kompakt_defconfig
@@ -60,6 +60,8 @@ CONFIG_GKI_HACKS_TO_FIX=y
 # CONFIG_CORE_DUMP_DEFAULT_ELF_HEADERS is not set
 CONFIG_CMA_AREAS=16
 CONFIG_ZSMALLOC=y
+CONFIG_LRU_GEN=y
+CONFIG_LRU_GEN_ENABLED=y
 CONFIG_DEFAULT_BIC=y
 CONFIG_TIPC=y
 CONFIG_VSOCKETS=y
