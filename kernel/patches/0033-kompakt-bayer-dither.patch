+/* Kompakt: ordered (Bayer) dithering in the loader instead of meink's Floyd-Steinberg. */
+#define KOMPAKT_FB_W     480
+#define KOMPAKT_FB_H     800
+#define KOMPAKT_FB_BYTES (KOMPAKT_FB_W * KOMPAKT_FB_H * 4)
+static int kompakt_dither;              /* kompakt_wf_dither: 0 meink FS, 1 Bayer 8x8, 2 Bayer 4x4, 3 Atkinson over Bayer */
+static int kompakt_dither_req;          /* the dither type last asked for, by the app or Auto */
+static bool kompakt_bayer_on;
+static u8 *kompakt_bayer_buf;
+static unsigned int kompakt_cut_lo = 48;    /* kompakt_wf_dither_cut: at or below goes black */
+static unsigned int kompakt_cut_hi = 208;   /* at or above goes white; only greys in between are patterned */
+static u16 kompakt_thr8[64], kompakt_thr4[16];
+static int kompakt_step = 8;            /* kompakt_wf_dither_step: Bayer spread of the hybrid, 32 is full Bayer */
+static s16 kompakt_hthr[64];
+static s16 *kompakt_err;                /* three rows of diffused error, two pixels of padding each side */
+#define KOMPAKT_ERR_ROW (KOMPAKT_FB_W + 4)
+extern void kompakt_request_repaint(void);
+
+static const u8 kompakt_bayer8[64] = {
+     0, 32,  8, 40,  2, 34, 10, 42,
+    48, 16, 56, 24, 50, 18, 58, 26,
+    12, 44,  4, 36, 14, 46,  6, 38,
+    60, 28, 52, 20, 62, 30, 54, 22,
