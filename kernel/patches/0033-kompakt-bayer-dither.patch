+/* Every dither request passes here; with kompakt_wf_dither set, meink's FS stays off and the loader dithers. */
+static void kompakt_set_dither(int type)
+{
+    WRITE_ONCE(kompakt_dither_req, type);
+    if (type && READ_ONCE(kompakt_dither)) {
+        EinkSetDitheringType(g_einkData.einkDrv, kEinkDitheringTypeNotSpecified);
+        WRITE_ONCE(kompakt_bayer_on, true);
+    } else {
+        WRITE_ONCE(kompakt_bayer_on, false);
+        EinkSetDitheringType(g_einkData.einkDrv, (enum EInkDitheringType)type);
+    }
+}
+
+/* Spread each matrix cell over the cut range, on meink's grey scale (the sum of three bytes, 0..765). */
+static void kompakt_bayer_thresholds(void)
+{
+    unsigned int lo = kompakt_cut_lo * 3, span = (kompakt_cut_hi - kompakt_cut_lo) * 3, i;
+
+    for (i = 0; i < 64; i++)
+        kompakt_thr8[i] = lo + (kompakt_bayer8[i] * 2 + 1) * span / 128;
+    for (i = 0; i < 16; i++)
+        kompakt_thr4[i] = lo + (kompakt_bayer4[i] * 2 + 1) * span / 32;
+    for (i = 0; i < 64; i++)
+        kompakt_hthr[i] = 128 + (kompakt_bayer8[i] * 2 - 63) * kompakt_step / 16;
+}
+
+/*
+ * Ordered error diffusion (J. van der Zwan): Atkinson's diffusion, whose 6/8 error keeps
+ * highlights and shadows clean, rounding against a Bayer threshold held close to the middle.
+ */
+static void *kompakt_hybrid(const void *src)
+{
+    const u32 *in = src;
+    u32 *out;
+    int x;                              /* signed: the diffusion writes to x - 1 */
+    unsigned int y;
+    int lo = READ_ONCE(kompakt_cut_lo), hi = READ_ONCE(kompakt_cut_hi);
+
+    if (!kompakt_bayer_buf)
+        kompakt_bayer_buf = vmalloc(KOMPAKT_FB_BYTES);
+    if (!kompakt_err)
+        kompakt_err = vmalloc(3 * KOMPAKT_ERR_ROW * sizeof(s16));
+    if (!kompakt_bayer_buf || !kompakt_err)
+        return NULL;
+    memset(kompakt_err, 0, 3 * KOMPAKT_ERR_ROW * sizeof(s16));
+    out = (u32 *)kompakt_bayer_buf;
+    for (y = 0; y < KOMPAKT_FB_H; y++) {
+        s16 *e0 = kompakt_err + (y % 3) * KOMPAKT_ERR_ROW + 2;
+        s16 *e1 = kompakt_err + ((y + 1) % 3) * KOMPAKT_ERR_ROW + 2;
+        s16 *e2 = kompakt_err + ((y + 2) % 3) * KOMPAKT_ERR_ROW + 2;
+        const s16 *row = kompakt_hthr + (y & 7) * 8;
+
+        memset(e2 - 2, 0, KOMPAKT_ERR_ROW * sizeof(s16));  /* it held row y - 1 */
+        for (x = 0; x < KOMPAKT_FB_W; x++, in++, out++) {
+            u32 p = *in;
+            int g = (((p & 0xff) + ((p >> 8) & 0xff) + ((p >> 16) & 0xff)) * 85) >> 8;
+            int v, q, e;
+
+            /* Outside the cut range the pixel is pure and passes no error on. */
+            if (g >= hi || g <= lo) {
+                *out = (p & 0xff000000) | (g >= hi ? 0x00ffffff : 0);
+                continue;
+            }
+            v = g + e0[x];
+            q = v > row[x & 7] ? 255 : 0;
+            *out = (p & 0xff000000) | (q ? 0x00ffffff : 0);
+            e = (v - q) / 8;
+            e0[x + 1] += e;
+            e0[x + 2] += e;
+            e1[x - 1] += e;
+            e1[x] += e;
+            e1[x + 1] += e;
+            e2[x] += e;
+        }
+    }
+    return kompakt_bayer_buf;
+}
+
+/* meink greys a pixel as the sum of its three low bytes (0..765); threshold that against the tiled matrix. */
+static void *kompakt_bayer(const void *src)
+{
+    const u32 *in = src;
+    u32 *out;
+    unsigned int x, y;
+    int coarse = READ_ONCE(kompakt_dither) == 2;
+    unsigned int lo = READ_ONCE(kompakt_cut_lo) * 3, hi = READ_ONCE(kompakt_cut_hi) * 3;
+
+    if (!kompakt_bayer_buf)
+        kompakt_bayer_buf = vmalloc(KOMPAKT_FB_BYTES);
+    if (!kompakt_bayer_buf)
+        return NULL;
+    out = (u32 *)kompakt_bayer_buf;
+    for (y = 0; y < KOMPAKT_FB_H; y++) {
+        const u16 *row = coarse ? kompakt_thr4 + (y & 3) * 4 : kompakt_thr8 + (y & 7) * 8;
+
+        for (x = 0; x < KOMPAKT_FB_W; x++, in++, out++) {
+            u32 p = *in;
+            unsigned int sum = (p & 0xff) + ((p >> 8) & 0xff) + ((p >> 16) & 0xff);
+            bool white = sum >= hi || (sum > lo && sum > row[coarse ? x & 3 : x & 7]);
+
+            *out = (p & 0xff000000) | (white ? 0x00ffffff : 0);
+        }
+    }
+    return kompakt_bayer_buf;
+}
