--- a/drivers/misc/mudita/eink_loader/eink_spi_hal.c
+++ b/drivers/misc/mudita/eink_loader/eink_spi_hal.c
@@ -28,6 +28,21 @@
 /* SPI Configuration Constants */
 #define EINK_SPI_MAX_SPEED_HZ  18000000  /* 18 MHz */
 
+/*
+ * Kompakt: clock for writes only; reads stay at EINK_SPI_MAX_SPEED_HZ. The
+ * controller divides 109.2 MHz by 2k, so a request lands on 54.6, 27.3, 18.2
+ * or 13.65 MHz, and stock's 18 MHz rounds down to 13.65. See
+ * docs/E-inkdriver.md.
+ */
+static int write_hz = 20000000;
+module_param(write_hz, int, 0644);
+MODULE_PARM_DESC(write_hz, "SPI clock requested for writes to the panel");
+
+static u32 eink_write_hz(void)
+{
+    return (write_hz >= 1000000 && write_hz <= 60000000) ? write_hz : EINK_SPI_MAX_SPEED_HZ;
+}
+
 static int dbglogLevel = 0;
 static const EinkCallbackTable_t* g_callbackTable = 0;
 
@@ -1099,7 +1114,7 @@
 	/* setup spi related info */
 	spi->bits_per_word = 8;
 	spi->mode = SPI_MODE_0;
-    spi->max_speed_hz = EINK_SPI_MAX_SPEED_HZ;
+    spi->max_speed_hz = eink_write_hz();
 	ret = spi_setup(spi);
 	if (ret < 0) {
 		dev_err(&spi->dev, "spi setup failed %d", ret);
@@ -1276,6 +1291,7 @@
     }
 
     spi->mode = SPI_MODE_0;
+    spi->max_speed_hz = eink_write_hz();
     retVal = spi_setup(spi);
