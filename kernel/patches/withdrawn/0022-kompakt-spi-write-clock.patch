+
+        if (us > 0)
+            pr_info("einkrate bytes=%u us=%lld khz=%lld\n",
+                    size, us, (s64)size * 8000 / us);
+    }
     if (dbglogLevel != 0)
     {
         nowtime = ktime_get();
@@ -1377,6 +1400,7 @@
