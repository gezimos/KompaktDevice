+        pr_info("kompakt-wf: gu16=%d du4=%d a2grey=%d a2frames=%u gl16trim=%u, %u record(s) rewritten, %s%s\n",
+                !!(flags & WF_GU16), !!(flags & WF_DU4), !!(flags & WF_A2GREY), WF_A2N(flags), WF_GLT(flags),
                 changed, cur >= 0 ? "re-uploaded " : "applies at the next waveform change",
                 cur >= 0 ? wf_name[wf_group(cur)] : "");
     return err;
