             idx % WF_BANDS, rec[0], crc32_le(0, rec, rec[0] * WF_FRAME + 0x41),
             rec[0] * WF_FRAME + 0x41,
-            done ? "" : " stock", done & WF_GU16 ? " gu16" : "",
+            done ? "" : " stock", done & WF_GU16 ? " gu16" : "", done & WF_DU4 ? " du4" : "",
             done & WF_GL16TRIM ? " gl16trim" : "",
             done & WF_A2GREY ? (done & WF_A2SHORT ? " a2grey a2frames" : " a2grey")
                              : (done & WF_A2SHORT ? " a2frames" : ""));
