diff --git a/drivers/misc/mudita/eink_loader/eink_spi_hal.c b/drivers/misc/mudita/eink_loader/eink_spi_hal.c
--- a/drivers/misc/mudita/eink_loader/eink_spi_hal.c
+++ b/drivers/misc/mudita/eink_loader/eink_spi_hal.c
@@ -760,7 +760,8 @@
             if (row_any[j] && (j == lo || !row_any[j - 1]))
                 runs++;
 
-        if (runs == 0 || obn + runs > MAX_BOXES) {
+        /* Kompakt: split only if every band after this one still gets a box; a dropped band was never refreshed. */
+        if (runs == 0 || obn + runs + (nboxes - i - 1) > MAX_BOXES) {
             /* no budget to split it: one span, exactly as before */
             obx[obn].c0 = c0;
             obx[obn].c1 = c1;
@@ -786,6 +787,13 @@
         }
     }
 
+    /* A band left without a box would keep the old picture; refresh the whole band set instead. */
+    if (i < nboxes) {
+        eink_semi_stage(rb, depth);
+        memcpy(last_frame, px, pxlen);
+        pr_info("einkpart: %u band(s), no box budget left; full update\n", nboxes);
+        return 0;
+    }
     for (i = 0; i < obn; i++)
         boxes[i] = obx[i];
     nboxes = obn;
