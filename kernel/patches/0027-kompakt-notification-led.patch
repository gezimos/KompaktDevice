+/* Kompakt: the LineageOS lights HAL timed nodes on PMIC breathing (kernel patch 0027). */
+static int mt6370_pmu_led_get_breath_regbase(struct led_classdev *led_cdev);
+
+static inline struct kompakt_led_pattern *kompakt_pat(struct led_classdev *led_cdev)
+{
+	return &container_of(led_cdev, struct mt6370_led_classdev, led_dev)->pat;
+}
+
+static u8 kompakt_breath_code(u32 ms, u32 base, u32 step)
+{
+	u32 code;
+
+	if (ms <= base)
+		return 0;
+	code = DIV_ROUND_CLOSEST(ms - base, step);
+	return code > MT6370_LEDBREATH_MAX ? MT6370_LEDBREATH_MAX : code;
+}
+
+static int kompakt_led_set_timing(struct led_classdev *led_cdev)
+{
+	struct kompakt_led_pattern *pat = kompakt_pat(led_cdev);
+	u32 ramp = pat->ramp_step_ms * (pat->duty_cnt > 0 ? pat->duty_cnt : 1);
+	u8 tr = kompakt_breath_code(ramp / 2, 125, 200);
+	u8 ton = kompakt_breath_code(pat->pause_hi, 125, 200);
+	u8 toff = kompakt_breath_code(pat->pause_lo, 250, 400);
+	int base, ret;
+
+	base = mt6370_pmu_led_get_breath_regbase(led_cdev);
+	if (base < 0)
+		return base;
+	ret = mt6370_pmu_led_update_bits(led_cdev, base, 0xFF, (tr << 4) | tr);
+	if (ret < 0)
+		return ret;
+	ret = mt6370_pmu_led_update_bits(led_cdev, base + 1, 0xFF, (tr << 4) | tr);
+	if (ret < 0)
+		return ret;
+	return mt6370_pmu_led_update_bits(led_cdev, base + 2, 0xFF, (ton << 4) | toff);
+}
+
+static int kompakt_led_breathe(struct led_classdev *led_cdev)
+{
+	struct kompakt_led_pattern *pat = kompakt_pat(led_cdev);
+	int led_index = mt6370_pmu_led_get_index(led_cdev);
+	u8 en_mask = 0x80 >> led_index;
+	int level = led_cdev->brightness, peak = 0, i, ret;
+
+	if (!level) {
+		for (i = 0; i < pat->duty_cnt; i++)
+			peak = max_t(int, peak, pat->duty[i]);
+		level = DIV_ROUND_UP(peak * led_cdev->max_brightness, 100);
+	}
+	if (!level) {
+		led_set_brightness(led_cdev, LED_OFF);
+		return 0;
+	}
+	if (pat->timed) {
+		ret = kompakt_led_set_timing(led_cdev);
+		if (ret < 0)
+			return ret;
+	}
+	ret = mt6370_pmu_led_update_bits(led_cdev, MT6370_PMU_REG_RGBEN,
+					 en_mask, 0);
+	if (ret < 0)
+		return ret;
+	ret = mt6370_pmu_led_change_mode(led_cdev, MT6370_PMU_LED_BREATHMODE);
+	if (ret < 0)
+		return ret;
+	led_set_brightness(led_cdev, level);
+	return 0;
+}
+
+static ssize_t blink_show(struct device *dev,
+	struct device_attribute *attr, char *buf)
+{
+	struct led_classdev *led_cdev = dev_get_drvdata(dev);
+
+	return snprintf(buf, PAGE_SIZE, "%d\n", kompakt_pat(led_cdev)->blink);
+}
+
+static ssize_t blink_store(struct device *dev,
+	struct device_attribute *attr, const char *buf, size_t cnt)
+{
+	struct led_classdev *led_cdev = dev_get_drvdata(dev);
+	struct kompakt_led_pattern *pat = kompakt_pat(led_cdev);
+	unsigned long on = 0;
+	int ret;
+
+	ret = kstrtoul(buf, 10, &on);
+	if (ret < 0)
+		return ret;
+	mutex_lock(&led_cdev->led_access);
+	pat->blink = !!on;
+	if (on)
+		ret = kompakt_led_breathe(led_cdev);
+	else
+		ret = mt6370_pmu_led_change_mode(led_cdev,
+						 MT6370_PMU_LED_REGMODE);
+	mutex_unlock(&led_cdev->led_access);
+	return ret < 0 ? ret : cnt;
+}
+
+#define KOMPAKT_PAT_U32(_name, _timed)					\
+static ssize_t _name##_show(struct device *dev,				\
+	struct device_attribute *attr, char *buf)			\
+{									\
+	struct led_classdev *led_cdev = dev_get_drvdata(dev);		\
+									\
+	return snprintf(buf, PAGE_SIZE, "%u\n", kompakt_pat(led_cdev)->_name); \
+}									\
+static ssize_t _name##_store(struct device *dev,			\
+	struct device_attribute *attr, const char *buf, size_t cnt)	\
+{									\
+	struct led_classdev *led_cdev = dev_get_drvdata(dev);		\
+	struct kompakt_led_pattern *pat = kompakt_pat(led_cdev);	\
+	u32 v;								\
+	int ret = kstrtou32(buf, 10, &v);				\
+									\
+	if (ret < 0)							\
+		return ret;						\
+	mutex_lock(&led_cdev->led_access);				\
+	pat->_name = v;							\
+	pat->timed |= _timed;						\
+	mutex_unlock(&led_cdev->led_access);				\
+	return cnt;							\
+}
+
+KOMPAKT_PAT_U32(start_idx, false)
+KOMPAKT_PAT_U32(pause_lo, true)
+KOMPAKT_PAT_U32(pause_hi, true)
+KOMPAKT_PAT_U32(ramp_step_ms, true)
+
+static ssize_t duty_pcts_show(struct device *dev,
+	struct device_attribute *attr, char *buf)
+{
+	struct led_classdev *led_cdev = dev_get_drvdata(dev);
+	struct kompakt_led_pattern *pat = kompakt_pat(led_cdev);
+	int i, n = 0;
+
+	for (i = 0; i < pat->duty_cnt; i++)
+		n += snprintf(buf + n, PAGE_SIZE - n, i ? ",%u" : "%u",
+			      pat->duty[i]);
+	n += snprintf(buf + n, PAGE_SIZE - n, "\n");
+	return n;
+}
+
+static ssize_t duty_pcts_store(struct device *dev,
+	struct device_attribute *attr, const char *buf, size_t cnt)
+{
+	struct led_classdev *led_cdev = dev_get_drvdata(dev);
+	struct kompakt_led_pattern *pat = kompakt_pat(led_cdev);
+	u8 duty[KOMPAKT_DUTY_MAX];
+	const char *p = buf, *end = buf + cnt;
+	int n = 0;
+
+	while (p < end) {
+		u32 v = 0;
+
+		while (p < end && (*p == ',' || isspace(*p)))
+			p++;
+		if (p >= end || !*p)
+			break;
+		if (!isdigit(*p) || n >= KOMPAKT_DUTY_MAX)
+			return -EINVAL;
+		while (p < end && isdigit(*p)) {
+			v = v * 10 + (*p++ - '0');
+			if (v > 100)
+				return -EINVAL;
+		}
+		duty[n++] = v;
+	}
+	mutex_lock(&led_cdev->led_access);
+	memcpy(pat->duty, duty, n);
+	pat->duty_cnt = n;
+	mutex_unlock(&led_cdev->led_access);
+	return cnt;
+}
+
+static DEVICE_ATTR(blink, 0664, blink_show, blink_store);
+static DEVICE_ATTR(start_idx, 0664, start_idx_show, start_idx_store);
+static DEVICE_ATTR(duty_pcts, 0664, duty_pcts_show, duty_pcts_store);
+static DEVICE_ATTR(pause_lo, 0664, pause_lo_show, pause_lo_store);
+static DEVICE_ATTR(pause_hi, 0664, pause_hi_show, pause_hi_store);
+static DEVICE_ATTR(ramp_step_ms, 0664, ramp_step_ms_show, ramp_step_ms_store);
+
